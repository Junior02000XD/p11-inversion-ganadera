                  "fillColor": "#ffffff",
                  "fontColor": "#111111",
                  "left": 2140,
                  "top": 190,
                  "width": 380,
                  "height": 52,
                  "text": "Proxy (RNF-02): solo el dueño o un analista abre\nel documento; cada acceso queda registrado."
                },
                {
                  "_type": "UMLNoteView",
                  "_id": "suAUUOVPsw0uc0UF",
