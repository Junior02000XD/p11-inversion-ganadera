<Project>
  <!-- Reglas comunes a todos los proyectos de la API. -->
  <PropertyGroup>
    <!-- Aplica las reglas de estilo del .editorconfig al compilar (por ejemplo, usings sin uso). -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Necesario para que el compilador detecte los usings sin uso (IDE0005); no se exige documentar todo. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
</Project>
