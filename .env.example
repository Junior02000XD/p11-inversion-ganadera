# OPCIONAL. Sin .env el proyecto funciona con la clave de prueba P11.Pruebas-2026 y los puertos
# de siempre. Copiar como .env (no se sube al repo) solo para cambiar alguno de estos valores.

# Clave del usuario sa de SQL Server: mínimo 8 caracteres, con mayúsculas, minúsculas, números y símbolos.
# Si la cambias, guarda también la cadena de conexión de la API con la clave nueva:
#   cd apps/api
#   dotnet user-secrets set "ConnectionStrings:Principal" "Server=localhost,1433;Database=P11;User Id=sa;Password=<tu_clave>;TrustServerCertificate=True"
# P11_SQL_CLAVE=

# Puertos: cambiar solo si ya están ocupados en tu máquina (por ejemplo, un SQL Server instalado
# en Windows ya usa el 1433). Si cambias P11_PUERTO_SQL, guarda la cadena con ese puerto (como arriba).
# P11_PUERTO_SQL=1433
# P11_PUERTO_SMTP=1025
# P11_PUERTO_CORREO_WEB=8025

# Memoria máxima de SQL Server, en MB.
# P11_SQL_MEMORIA_MB=2048
