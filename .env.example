# Copiar como .env (no se sube al repo) y completar.

# Clave del usuario sa de SQL Server: mínimo 8 caracteres, con mayúsculas, minúsculas, números y símbolos.
# La misma clave va en la cadena de conexión de la API (dotnet user-secrets, ver apps/api/README.md).
P11_SQL_CLAVE=

# Opcionales: cambiar solo si el puerto ya está ocupado en tu máquina.
# P11_PUERTO_SQL=1433
# P11_PUERTO_SMTP=1025
# P11_PUERTO_CORREO_WEB=8025
# P11_SQL_MEMORIA_MB=2048
